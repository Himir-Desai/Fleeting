*.xcodeproj
!/Fleeting.xcodeproj/

# Generated by Tools/install-device.sh from project-personal.yml. Emptied by the script rather
# than by the spec, so a committed copy would be whichever of the two states it was caught in.
App/Fleeting-personal.entitlements
Widgets/FleetingWidgets-personal.entitlements
